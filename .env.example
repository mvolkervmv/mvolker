# Modelo de variáveis de ambiente do OpenClaw.
# Copie para /home/openclaw/.openclaw/.env no VPS e preencha.

# === OBRIGATÓRIO ===
# Chave da API da Anthropic (https://console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Modelo do Claude
ANTHROPIC_MODEL=claude-opus-4-8

# === OPCIONAL ===
# Fuso horário
TZ=America/Sao_Paulo

# Limite de segurança: exige aprovação antes de ações sensíveis (recomendado true)
REQUIRE_CONFIRMATION=true
