# Copie para mcp/contaazul/.env e preencha (chmod 600). NUNCA faça commit do .env.
# Credenciais em developers.contaazul.com → Minhas Aplicações.
CONTAAZUL_CLIENT_ID=
CONTAAZUL_CLIENT_SECRET=

# App de DESENVOLVIMENTO usa https://www.contaazul.com. App de PRODUÇÃO: a URL cadastrada no portal.
CONTAAZUL_REDIRECT_URI=https://www.contaazul.com

# 1 = expõe a ferramenta contaazul_write (POST/PUT/PATCH/DELETE). Padrão: somente leitura.
CONTAAZUL_ALLOW_WRITE=0

# Opcionais — só mude se a documentação oficial indicar outros valores.
# CONTAAZUL_API_BASE=https://api-v2.contaazul.com
# CONTAAZUL_AUTH_URL=https://auth.contaazul.com/login
# CONTAAZUL_TOKEN_URL=https://auth.contaazul.com/oauth2/token
# CONTAAZUL_SCOPE=openid profile aws.cognito.signin.user.admin
# CONTAAZUL_TOKEN_FILE=tokens.json
