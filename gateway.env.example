# Modelo de /root/.openclaw/gateway.env  (chmod 600)
# Carregado antes de iniciar o gateway e pelo cron @reboot.

# Fuso horário
TZ=America/Sao_Paulo

# Evita overhead de auto-respawn do OpenClaw
OPENCLAW_NO_RESPAWN=1

# Permite bypassPermissions rodando como root (VPS dedicado/isolado).
# Também é forçado dentro do wrapper /usr/bin/claude.
IS_SANDBOX=1

# NÃO coloque CLAUDE_CODE_OAUTH_TOKEN aqui:
# o OpenClaw remove essa variável do processo filho, e a autenticação usa o
# login persistente em disco (/root/.claude.json + /root/.claude/.credentials.json).
